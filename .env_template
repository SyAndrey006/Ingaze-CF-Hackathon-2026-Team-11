# Copy this file to .env and fill in one provider key.

# Generic key, used with the configured provider or LLM_BASE_URL.
LLM_API_KEY=

# Optional OpenAI-compatible endpoint; examples: OpenRouter https://openrouter.ai/api/v1
# or Gemini https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=

# Optional model; examples: OpenAI gpt-4o-mini, OpenRouter openai/gpt-4o-mini,
# Gemini gemini-2.5-flash.
LLM_MODEL=

# Provider-specific key fallbacks (set only the one you use).
OPENAI_API_KEY=       # OpenAI example: your OpenAI API key
OPENROUTER_API_KEY=   # OpenRouter example: your OpenRouter API key
GEMINI_API_KEY=       # Gemini example: your Google AI Studio API key
